# Postgres. The local default matches docker-compose.yml.
DATABASE_URL=postgresql+psycopg://pawsible:pawsible@localhost:5432/pawsible

# RescueGroups.org v5. Free key on request; sent as the Authorization header verbatim.
# https://rescuegroups.org/services/adoptable-pet-data-api/
RESCUEGROUPS_API_KEY=

# Anthropic. Leave unset if you have run `ant auth login` -- the SDK reads that profile.
ANTHROPIC_API_KEY=

# Extraction routing. Tier 1 is the cheap pass; tier 2 repairs and escalations.
# Which pair is correct is an eval question, not a guess -- these are the starting point.
PAWSIBLE_TIER1_MODEL=claude-haiku-4-5
PAWSIBLE_TIER2_MODEL=claude-sonnet-5

# Rollout seed. Scope is national; these bound which listings the *backfill* admits so
# accuracy and cost per 1k listings can be confirmed before widening. Leave the location
# empty to ingest nationwide.
PAWSIBLE_SEED_LOCATION=15222
PAWSIBLE_SEED_RADIUS_MI=100
